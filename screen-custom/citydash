#!/bin/sh /etc/rc.common
START=95
USE_PROCD=1
start_service() {
    if ! python3 -c 'import sys;sys.path.insert(0,"/root/dashboard");import mudi_ui,backend;s=backend.pin_settings();assert(not s["enabled"] or s["valid"])' >/dev/null 2>&1; then
        logger -t citydash 'screen preflight failed; keeping factory screen'
        /etc/init.d/gl_screen enable
        /etc/init.d/gl_screen start
        return 1
    fi
    # Avoid two framebuffer writers if an upgrade re-enabled the factory service.
    if pidof gl_screen >/dev/null; then
        /etc/init.d/gl_screen stop
        for pid in $(pidof gl_screen); do
            case "$(tr '\0' ' ' < /proc/$pid/cmdline 2>/dev/null)" in
                /usr/bin/gl_screen*) kill -KILL "$pid" 2>/dev/null ;;
            esac
        done
    fi
    procd_open_instance
    procd_set_param command /bin/sh /root/dashboard/run.sh
    procd_set_param nice -5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
